{
  "manifest_version": 3,
  "name": "Dev ToolBox Pro",
  "version": "1.1.0",
  "description": "A minimalist dev formatter for JSON and SQL. Format, validate, and copy with ease.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Dev ToolBox Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
{
  "manifest_version": 3,
  "name": "Dev ToolBox Pro",
  "version": "1.1.0",
  "description": "Format JSON and SQL, decode Base64 and JWT, convert Unix time, and diff text — locally in a Chrome side panel.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Dev ToolBox Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

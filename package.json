{
  "name": "dev-toolbox-pro",
  "version": "1.1.1",
  "private": true,
  "description": "Format JSON and SQL, decode Base64 and JWT, convert Unix time, and diff text — locally in a Chrome side panel.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "icons": "node generate_icons.mjs",
    "pack": "npm run build && node pack.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.2.0",
    "codemirror": "^5.65.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "sql-formatter": "^15.0.0"
  }
}
